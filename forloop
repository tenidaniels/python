print("NUMBER SUMMATION AND LOOP LEARNING TOOL")  # Print the title header for the learning tool
print("-" * 40)  # Print a visual divider line consisting of 40 dashes

try:  # Begin a try-except block to safely handle potential user input errors
    limit = int(input("Enter a positive whole number: "))  # Prompt the user for input and convert the string to an integer

    if limit <= 0:  # Check if the entered number is less than or equal to zero
        print("Invalid input. Enter a number greater than zero.")  # Print an error message if the number is non-positive
    else:  # Execute this block if the input is a valid positive number
        total = 0  # Initialize the running sum total variable to zero

        print("\nCalculating the sum using a for loop:")  # Print a header message before the loop begins

        for number in range(1, limit + 1):  # Loop through numbers from 1 up to and including the limit
            total = total + number  # Add the current number to the running total sum
            print("Number:", number, "| Running total:", total)  # Print the current iteration number and updated total

        formula_total = limit * (limit + 1) // 2  # Calculate the sum using the mathematical Gauss formula n(n+1)/2

        print("\nRESULTS")  # Print a results header separator
        print("Loop-based total:", total)  # Display the final sum calculated iteratively via the loop
        print("Formula-based total:", formula_total)  # Display the final sum calculated via the math formula

        if total == formula_total:  # Check if both calculation methods yield the exact same result
            print("Verification successful: both results match.")  # Print success message if results match
        else:  # Handle the unlikely case where results do not match
            print("Verification failed: the results do not match.")  # Print failure message if results differ

except ValueError:  # Catch ValueError exceptions if the user inputs non-numeric characters (e.g., text or decimals)
    print("Invalid input. Please enter a whole number.")  # Print an error message prompting for a valid whole number
